{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hanigames",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-07",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hani-games-db",
      "database_id": "e8aa0913-f0c7-449e-a0de-08bcdc7487db"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "GameRoom",
        "class_name": "GameRoom"
      }
    ]
  },

  "exports": {
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
