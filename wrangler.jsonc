{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hanigames",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hani-games-db",
      "database_id": "e8aa0913-f0c7-449e-a0de-08bdc7487db"
    }
  ],
  "exports": {
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
